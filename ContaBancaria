public class ContaBancaria {

    private String titular;
    private double saldo;
    private double limite;


    public ContaBancaria(String titular, double limite) {

        this.titular = titular;
        this.saldo = 0;
        this.limite = limite;

    }

    //Metodos
    public double getSaldo() {
        return saldo;
    }

    public void sacar(double valor) {

        if (valor <= 0) {
            IO.println("Não ha como sacar $0");

        } else if (valor <= saldo + limite) {
            saldo = valor;
            IO.println("Saque realizado");

        } else {
            IO.println("Saldo insuficiente");
        }

    }

    public void depositar(double valor) {

        if (valor > 0) {
            saldo += valor;
            IO.println("Deposito realizado");

        } else {
            IO.println("O valor para depositar tem que ser maior que 0");
        }

    }

    public void sair() {
        System.exit(0);
    }

    //Atributos
    public static void main(String[] args) {

        String menu = IO.readln("Deseja abrir o aplicativo do banco(s/n):");
        if (menu.equals("s")) {
            IO.println("Sistema iniciado");
       
        } else if (menu.equals("n")) {
            IO.println("Sistema desligando");
            System.exit(0);
        }


        ContaBancaria conta = new ContaBancaria("cliente", 500);
        String escolha = "";
        while (!escolha.equals("4")) {


            IO.println("|==========================|");
            IO.println("|===== Conta Bancaria =====|");
            IO.println("|==                      ==|");
            IO.println("|==   1.Conferir Saldo   ==|");
            IO.println("|==       2.Sacar        ==|");
            IO.println("|==      3.Depositar     ==|");
            IO.println("|==        4.Sair        ==|");
            IO.println("|==                      ==|");
            IO.println("|===== Conta Bancaria =====|");
            IO.println("|==========================|");
            escolha = IO.readln("Digite um numero entre 1 e 4: ");

            if (escolha.equals("1")) {
                IO.println("Saldo: R$" + conta.getSaldo());

            } else if (escolha.equals("2")) {
                double valor = Double.parseDouble(IO.readln("Quanto deseja sacar: "));
                conta.sacar(valor);

            } else if (escolha.equals("3")) {
                double valor = Double.parseDouble(IO.readln("Quanto deseja depositar: "));
                conta.depositar(valor);

            } else if (escolha.equals("4")) {
                conta.sair();

            }

        
        }
        
    }
}
    }



}
